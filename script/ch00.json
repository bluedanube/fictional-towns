{
  "id": "ch00",
  "title": "橋のたもと",
  "girl": null,
  "status": "draft",
  "scenes": [
    {
      "bg": "sewn-town/00-bridge-dusk",
      "time": "dusk",
      "bgm": null,
      "se": [
        "water-low",
        "bell-far"
      ],
      "lines": [
        {
          "who": "narr",
          "text": "水の音がする。橋の西のたもとに、わたしは着く。",
          "book": true
        },
        {
          "who": "narr",
          "text": "空は白く、まだ明るい。"
        },
        {
          "who": "narr",
          "text": "小屋のそばで、梯子を肩にかけた人が立ち止まる。"
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「通りがかりですか。これから灯を点けて回るところです」"
        },
        {
          "who": "narr",
          "text": "胸の名札に、灯谷とある。"
        },
        {
          "who": "narr",
          "text": "小屋の窓に、青白い灯が一つ下がっている。まだ、点いていない。"
        },
        {
          "who": "narr",
          "text": "梯子の足は、何度も継ぎ直されて、少し色が違う。"
        },
        {
          "who": "narr",
          "text": "灯谷さんが、いちばん手前の街灯に触れる。白い空の下で、灯がぽつりと点く。",
          "book": true
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「少し早いんです。ときどき、日暮れより先に点いてしまう」"
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「そういう日もあります。気にしないで」"
        },
        {
          "who": "narr",
          "text": "通りのむこうへ、灯が一つずつ続いていく。青白い光だ。",
          "book": true
        },
        {
          "who": "narr",
          "text": "灯のまわりに、小さな虫が集まる。夜は、もうすぐだ。"
        },
        {
          "who": "narr",
          "text": "遠くで、時計が一度だけ鳴る。",
          "book": true
        },
        {
          "who": "narr",
          "text": "足を止めている人がいる。わたしも、止まる。"
        },
        {
          "who": "narr",
          "text": "店先の人も、道の人も、同じ方角を見ている。時計の店のほうだ。"
        },
        {
          "who": "narr",
          "text": "やがて人は、何事もなかったように、また歩きだす。"
        },
        {
          "who": "narr",
          "text": "何の合図なのかは、わからない。わかろうとも、思わない。"
        },
        {
          "who": "narr",
          "text": "灯谷さんは、わたしの顔を見て、小さく笑う。"
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「みなさん、そうなります」"
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「今夜は、少し歩くといい。灯のあるほうへ」"
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「橋を渡ると、東の街です。そちらも、ついでに見ていってください」"
        },
        {
          "who": "narr",
          "text": "水の音が、ずっと足もとを流れている。"
        },
        {
          "who": "narr",
          "text": "橋の下の水路は、暗渠の口から出て、細く光っている。"
        },
        {
          "who": "narr",
          "text": "向こう岸の広場にも、うす青い灯が一つ、見える。"
        },
        {
          "who": "narr",
          "text": "わたしは頭を下げて、橋に背を向ける。"
        },
        {
          "who": "U3-05",
          "icon": "U3-05",
          "text": "「また、あした。」"
        }
      ],
      "choice": {
        "enabled": false,
        "prompt": "",
        "options": []
      },
      "bg_missing": true
    }
  ]
}
